{
  "compilerOptions": {
    "typeRoots": ["types", "node_modules/@types"],
    "target": "ES2021",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@config/*": ["config/*"],
      "@db/*": ["db/*"],
      "@routes/*": ["routes/*"],
      "@controllers/*": ["controllers/*"],
      "@services/*": ["services/*"],
      "@models/*": ["models/*"],
      "@interfaces/*": ["interfaces/*"],
       "@app/*":["app"]
    }
  },
  "include": ["src", "types"]
}
